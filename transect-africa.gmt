#!/bin/bash

# setting the frame of the graph to be of plain style (no black and white bar)
gmt gmtset PS_MEDIA = a1
gmt gmtset MAP_FRAME_TYPE = plain

gmt makecpt -Chot -T-20/40/0.1 > ./cmap/chelsa_temp.cpt
gmt makecpt -Chot -T-20/40/0.1 > ./cmap/chelsa_temp.cpt
gmt makecpt -Cetopo1 -T0/9/0.001 > etopo1_km.cpt
gmt makecpt -Cocean -T0/5/0.001 -I > ./cmap/chelsa_ppn_m.cpt
gmt makecpt -Cabyss -T0/678/1 -I > ./cmap/abyss_birds.cpt


# REGION & SCALE of maps
rgn=-R-180/180/-90/90
scl=-JKf10c

# and of chart on the right
cht=-JX15c/5c

# tif files to use for maps
sr=./birds_no_seabirds_sr_wgs84.grd #birds
prec=./12_geographic_lowres_10km.grd # CHELSA precipitation
topo=./ETOPO1_Ice_g_gmt4_lowres_10km.grd
temp=./1_geographic_lowres_10km.grd # CHELSA temperature
temprange=./7_geographic_lowres_10km.grd # CHELSA temperature range


# original resolution
prec_30arcs=./12_geographic.grd
topo_1arcmin=./ETOPO1_Ice_g_gmt4.grd
temp_30arcs=./1_geographic.grd
temprange_30arcs=./7_geographic.grd

continet=africa
mkdir ./pics/$continet/

# gaussian filter value
# filteringvalue=10
for filteringvalue in 50 200 150; do 
    echo 'starting with gaussian filtering value' $filteringvalue 'Km'

    ######### VALUES EXTRACTION FROM TRANSECTS #########
    for i in 0; do 
        echo "working on" $i
        #outfile
        
        picps=./pics/$continet/derivatives_${i}_${filteringvalue}km.ps
        piceps=./pics/$continet/derivatives_${i}_${filteringvalue}km.eps

        # Define latitude range (e.g., between -60 and 60 for the Americas)
        lat0=$i
        lat1=$i

        # Define start and end longitude
        lon0=-19  # Start longitude
        lon1=52   # End longitude

        # Placing tose coordinates in a file
        touch transect.ll
        echo $lon0 $lat0 > transect.ll
        echo $lon1 $lat1 >> transect.ll
        

        # generating the transect every 10 Km
        # gmt sample1d transect.ll -I10k | gmt mapproject -Gk > transect_temp.ll # this would employ great circle distances
        gmt sample1d transect.ll -I10k -Apl | gmt mapproject -Gk > transect_temp.ll # instead this one uses Rhumb lines

        # Filter out OCEANS 
        # Track points against the land mask
        gmt grdtrack transect_temp.ll -Gland_mask_forETOPO.grd > transect_with_mask.ll
        # Filter out points in the ocean (where landmask value is 0)
        awk '$4 == 1 {print $1, $2, $3}' transect_with_mask.ll > transect_filtered.ll

        # RECALCULATE the distance 
        # Get the first distance value from the data (3rd column of the 2nd line onward)
        first_distance=$(awk 'NR==1 {print $3}' transect_filtered.ll)
        # Process each line, adjusting the distance column to start from zero
        awk -v first_dist="$first_distance" '{$3 = $3 - first_dist; print }' transect_filtered.ll > transect_filtered_updated_distance.ll



        # getting the number species of the transect and precipitations
        echo "Longitude Latitude Distance SpeciesRichness Precipitation Topography Temperature TempRange" > transect.lldspetr
        gmt grdtrack transect_filtered_updated_distance.ll -G$sr -G$prec_30arcs -G$topo_1arcmin -G$temp_30arcs -G$temprange_30arcs >> transect.lldspetr

        # applying the gaussian smoothing to all env variables
        awk 'NR > 1 {print $3, $4}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > sr_gauss.txt
        awk 'NR > 1 {print $3, $5}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > prec_gauss.txt
        awk 'NR > 1 {print $3, $6}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > topo_gauss.txt
        awk 'NR > 1 {print $3, $7}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > temp_gauss.txt
        awk 'NR > 1 {print $3, $8}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > temprange_gauss.txt

        # Combine all files into a new file, including the original first two columns (longitude and latitude)
        echo "Distance SpeciesRichness Precipitation Topography Temperature TempRange" > transect_gauss.lldspetr
        paste <(awk '{print $1, $2}' sr_gauss.txt) \
            <(awk '{print $2}' prec_gauss.txt ) \
            <(awk '{print $2}' topo_gauss.txt) \
            <(awk '{print $2}' temp_gauss.txt) \
            <(awk '{print $2}' temprange_gauss.txt) \
            >> transect_gauss.lldspetr

        # run the python script to calculate absoulte derivatives
        python3 derivative.py
        # the script above will also calculate the correlation coefficeint
        

        # gaussian smoothing of the derivatives, derivative of the original function is stored in derivtaive_ens.dd
        awk 'NR > 1 {print $1, $2}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > prec_der_gauss.txt
        awk 'NR > 1 {print $1, $3}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > topo_der_gauss.txt
        awk 'NR > 1 {print $1, $4}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > temp_der_gauss.txt
        awk 'NR > 1 {print $1, $5}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > range_der_gauss.txt

        # Combine all files into a new file whihc will contain gaussian smoothed derivatives
        echo "Distance  Precipitation Topography Temperature TempRange" > derivatives_env_gauss.lldspetr
        paste <(awk '{print $1, $2}' prec_der_gauss.txt ) \
            <(awk '{print $2}' topo_der_gauss.txt) \
            <(awk '{print $2}' temp_der_gauss.txt) \
            <(awk '{print $2}' range_der_gauss.txt) \
            >> derivatives_env_gauss.lldspetr
        
        # create a chart of correlations 
        python3 correlation-charts.py
        mv correlation.jpg ./pics/$continet/correlation_${i}_${filteringvalue}.jpg
        # Clean up intermediate files
        rm prec_gauss.txt topo_gauss.txt temp_gauss.txt temprange_gauss.txt sr_gauss.txt prec_der_gauss.txt topo_der_gauss.txt temp_der_gauss.txt range_der_gauss.txt


        # plot species as a function of distance, first we calculate the range
        mind=$(awk 'NR > 1 {if(min=="") {min=$3}; if($3 < min) min=$3} END {print min-10}' transect.lldspetr) 
        maxd=$(awk 'NR > 1 {if($3 > max) max=$3} END {print max+10}' transect.lldspetr)
        maxsr=$(awk 'NR > 1 {if($4 > max) max=$4} END {print max+10}' transect.lldspetr)

        # calculating the maximum vale of the derivate so to set limits on plots (this is an alternative way to extract values with awk, vs the one above)
        maxprder=$(awk 'NR > 1 {if($2 > max) max=$2} END {print max+10}' derivatives_env.dd)
        maxtopoder=$(awk 'NR > 1 {if($3 > max) max=$3} END {print max+10}' derivatives_env.dd)
        maxtempder=$(awk 'NR > 1 {if($4 > max) max=$4} END {print max+0}' derivatives_env.dd)
        maxrangeder=$(awk 'NR > 1 {if($5 > max) max=$5} END {print max+0}' derivatives_env.dd)

        # awk 'NR%1000==1' <  file.dxy | awk '{print $1, $2}' < file | psxy 

        # defining the  -R flag limits
        limpr_der=-R$mind/$maxd/0/$maxprder
        limtopo_der=-R$mind/$maxd/0/$maxtopoder
        limtemp_der=-R$mind/$maxd/0/$maxtempder
        limrange_der=-R$mind/$maxd/0/$maxrangeder


        # calculating the maximum value of the precipitations (and so on) so to set limits on plots
        maxpr=$(awk 'NR > 1 {if($5 > max) max=$5} END {print max+100}' transect.lldspetr)
        maxtopo=$(awk 'NR > 1 {if($6 > max) max=$6} END {print max+100}' transect.lldspetr)
        maxtemp=$(awk 'NR > 1 {if($7 > max) max=$7} END {print max+10}' transect.lldspetr)
        maxrange=$(awk 'NR > 1 {if($8 > max) max=$8} END {print max+10}' transect.lldspetr)

        # defining the  -R flag limits
        limsr=-R$mind/$maxd/0/$maxsr
        limpr=-R$mind/$maxd/0/$maxpr
        limtopo=-R$mind/$maxd/0/$maxtopo
        limtemp=-R$mind/$maxd/0/$maxtemp
        limrange=-R$mind/$maxd/0/$maxrange


        #### SR  Lat transect
        ####     ############

        # plotting the map as first thing
        gmt psbasemap $rgn $scl -Bx180f30+l"Longitude, degrees" -By30f2+l"Latitude, degrees" -BWsne -P -K -Y30c > $picps

        # plotting the coastlines
        gmt pscoast $rgn $scl -Ba0 -A10000+l -Ggray -W0.005i,black -O -K >> $picps

        # Plot the species richness file with handling for NoData value (-Q flag)
        gmt grdimage $rgn $scl $sr -C./cmap/abyss_birds.cpt  -Q -O -K >> $picps
        # adding another coastline for better definition
        gmt pscoast $rgn $scl -W0.005i,black -Df+ -A20000+l -O -K >> $picps

        # plot transect on map
        awk '{print $1, $2}' < transect.lldspetr | gmt psxy $rgn $scl -Ba0 -W1.5p,black -O -K >> $picps

        # plot the species richness values on a separate plot on the right
        gmt psbasemap $limsr $cht -Bx1000f100 -By100f50 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X15c -K >> $picps
        awk 'NR > 1 {print $3, $4}' < transect.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,black -O -K >> $picps




        #### PR  der#######
        ####     ##########

        # plotting the map as first thing
        gmt psbasemap $rgn $scl -Bx180f30+l"Longitude, degrees" -By30f2+l"Latitude, degrees" -BWsne -O -K -Y-6c -X-15c >> $picps

        # Step 1: Create the clip path for land, excluding islands smaller than 20000 kmsq
        gmt pscoast $rgn $scl -Df+ -A20000+l -Gc -O -K >> $picps  # -Gc: Create clip path based on land excluding islands
        # Step 2: Plot the elevation data, clipped to the land areas
        gmt grdimage $rgn $scl $prec -C./cmap/chelsa_ppn.cpt -O -K >> $picps
        # Step 3: End the clip path
        gmt psclip -C -O -K >> $picps
        # Step 4: Plot the coastlines separately, without clipping
        gmt pscoast $rgn $scl -W0.005i,black -Df+ -A20000+l -O -K >> $picps  # Now we draw the coastlines


        # plot transect on map
        awk 'NR > 1 {print $1, $2}' < transect.lldspetr | gmt psxy $rgn $scl -Ba0 -W1.5p,black -O -K >> $picps

        # plot the derivative values on a separate plot on the right
        gmt psbasemap $limpr_der $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X15c -K >> $picps
        awk 'NR > 1 {print $1, $2}' < derivatives_env.dd | gmt psxy $limpr_der $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $2}' < derivatives_env_gauss.lldspetr | gmt psxy $limpr_der $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "derivative_precipitation" {print $2}' correlation_results.txt)"
        x=$(echo "$maxd - 300" | bc)
        y=$(echo "$maxprder - 10" | bc)
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        x_text=$(echo "$mind + 100" | bc)
        echo $x_text $y "Derivative" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps


        # plot the precipitations values on a separate plot on the right
        gmt psbasemap $limpr $cht -Bx1000f100 -By1000f500 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X17c -K >> $picps
        awk 'NR > 1 {print $3, $5}' < transect.lldspetr | gmt psxy $limpr $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $3}' < transect_gauss.lldspetr | gmt psxy $limpr $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "precipitation" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Precipitation, mm" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps



        #### EL  der#######
        ####     ##########

        # plotting the map as first thing
        gmt psbasemap $rgn $scl -Bx180f30+l"Longitude, degrees" -By30f2+l"Latitude, degrees" -BWsne -O -K -Y-6c -X-32c >> $picps


        # Step 1: Create the clip path for land, excluding islands smaller than 20000 kmsq
        gmt pscoast $rgn $scl -Df+ -A20000+l -Gc -O -K >> $picps  # -Gc: Create clip path based on land excluding islands
        # Step 2: Plot the elevation data, clipped to the land areas
        gmt grdimage $rgn $scl $topo -Cetopo1 -O -K >> $picps
        # Step 3: End the clip path
        gmt psclip -C -O -K >> $picps
        # Step 4: Plot the coastlines separately, without clipping
        gmt pscoast $rgn $scl -W0.005i,black -Df+ -A20000+l -O -K >> $picps  # Now we draw the coastlines


        # plot transect on map
        awk 'NR > 1 {print $1, $2}' < transect.lldspetr | gmt psxy $rgn $scl -Ba0 -W1.5p,black -O -K >> $picps

        # plot the derivative values on a separate plot on the right
        gmt psbasemap $limtopo_der $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X15c -K >> $picps
        awk 'NR > 1 {print $1, $3}' < derivatives_env.dd | gmt psxy $limtopo_der $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $3}' < derivatives_env_gauss.lldspetr | gmt psxy $limtopo_der $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "derivative_topography" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Derivative" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps

        
        # plot the elevation values on a separate plot on the right
        gmt psbasemap $limtopo $cht -Bx1000f100 -By1000f500 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X17c -K >> $picps
        awk 'NR > 1 {print $3, $6}' < transect.lldspetr | gmt psxy $limtopo $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $4}' < transect_gauss.lldspetr | gmt psxy $limtopo $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "topography" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Elevation, m" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps




        #### MAT  der#######
        ####     ##########

        # plotting the map as first thing
        gmt psbasemap $rgn $scl -Bx180f30+l"Longitude, degrees" -By30f2+l"Latitude, degrees" -BWsne -O -K -Y-6c -X-32c >> $picps


        # Step 1: Create the clip path for land, excluding islands smaller than 20000 kmsq
        gmt pscoast $rgn $scl -Df+ -A20000+l -Gc -O -K >> $picps  # -Gc: Create clip path based on land excluding islands
        # Step 2: Plot the elevation data, clipped to the land areas
        gmt grdimage $rgn $scl $temp -C./cmap/chelsa_temp.cpt -O -K >> $picps
        # Step 3: End the clip path
        gmt psclip -C -O -K >> $picps
        # Step 4: Plot the coastlines separately, without clipping
        gmt pscoast $rgn $scl -W0.005i,black -Df+ -A20000+l -O -K >> $picps  # Now we draw the coastlines


        # plot transect on map
        awk 'NR > 1 {print $1, $2}' < transect.lldspetr | gmt psxy $rgn $scl -Ba0 -W1.5p,black -O -K >> $picps

        # plot the derivative values on a separate plot on the right
        gmt psbasemap $limtemp_der $cht -Bx1000f100 -By0.05f0.001 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X15c -K >> $picps
        awk 'NR > 1 {print $1, $4}' < derivatives_env.dd | gmt psxy $limtemp_der $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $4}' < derivatives_env_gauss.lldspetr | gmt psxy $limtemp_der $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "derivative_temperature" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Derivative" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps


        # plot the temperature values on a separate plot on the right
        gmt psbasemap $limtemp $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X17c -K >> $picps
        awk 'NR > 1 {print $3, $7}' < transect.lldspetr | gmt psxy $limtemp $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $5}' < transect_gauss.lldspetr | gmt psxy $limtemp $cht -Ba0 -W0.02i,black -O -K >> $picps 
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "temperature" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Mean Annual Temperature, C" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps




        #### TR  der#######
        ####     ##########

        # plotting the map as first thing
        gmt psbasemap $rgn $scl -Bx180f30+l"Longitude, degrees" -By30f2+l"Latitude, degrees" -BWsne -O -K -Y-6c -X-32c >> $picps


        # Step 1: Create the clip path for land, excluding islands smaller than 20000 kmsq
        gmt pscoast $rgn $scl -Df+ -A20000+l -Gc -O -K >> $picps  # -Gc: Create clip path based on land excluding islands
        # Step 2: Plot the elevation data, clipped to the land areas
        gmt grdimage $rgn $scl $temprange -C./cmap/chelsa_trange.cpt -O -K >> $picps
        # Step 3: End the clip path
        gmt psclip -C -O -K >> $picps
        # Step 4: Plot the coastlines separately, without clipping
        gmt pscoast $rgn $scl -W0.005i,black -Df+ -A20000+l -O -K >> $picps  # Now we draw the coastlines


        # plot transect on map
        awk 'NR > 1 {print $1, $2}' < transect.lldspetr | gmt psxy $rgn $scl -Ba0 -W1.5p,black -O -K >> $picps

        # plot the derivative values on a separate plot on the right
        gmt psbasemap $limrange_der $cht -Bx1000f100+l"Distance, km" -By0.05f0.001 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X15c -K >> $picps
        awk 'NR > 1 {print $1, $5}' < derivatives_env.dd | gmt psxy $limrange_der $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $5}' < derivatives_env_gauss.lldspetr | gmt psxy $limrange_der $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "derivative_temperature_range" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Derivative" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps


        # plot the temperature values on a separate plot on the right
        gmt psbasemap $limrange $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p  -BWS -O -X17c -K >> $picps
        awk 'NR > 1 {print $3, $8}' < transect.lldspetr | gmt psxy $limrange $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $6}' < transect_gauss.lldspetr | gmt psxy $limrange $cht -Ba0 -W0.02i,black -O -K >> $picps
        # plot the r, correlation coeffient
        r="r=$(awk '$1 == "temperature_range" {print $2}' correlation_results.txt)"
        echo $x $y $r | gmt pstext $limpr_der $cht -F+f16p -N -O -K >> $picps
        # plot text that says what plot is what
        echo $x_text $y "Temperature Range, C" | gmt pstext $limpr_der $cht -F+f12p+jL -N -O -K >> $picps


        # add scales on the right 
        gmt psscale -C./cmap/abyss_birds.cpt -Dx-21c/24c+w5c/0.5c+v -B100+l"Species Richness" --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O -K >> $picps
        gmt psscale -C./cmap/chelsa_ppn_m.cpt -Dx-21c/18c+w5c/0.5c+v -B1+l"Precipitations, m" --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O -K >> $picps
        # gmt psscale -Cetopo1 -Dx16c/12c+w5c/0.5c+v -B2000+l"Elevation, m"  --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O -K >> $picps
        gmt psscale -C./cmap/etopo1_km.cpt -Dx-21c/12c+w5c/0.5c+v -B2+l"Elevation, km" --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O -K >> $picps
        gmt psscale -C./cmap/chelsa_temp.cpt -Dx-21c/6c+w5c/0.5c+v -B10+l"Mean Annual Temp" --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O -K >> $picps
        gmt psscale -C./cmap/chelsa_trange.cpt -Dx-21c/0c+w5c/0.5c+v -B10+l"Temp Range" --FONT_ANNOT_PRIMARY=12p --FONT_LABEL=26p -O >> $picps
        

        # finishing up
        # Convert to JPEG
        ps2eps -f $picps
        gmt psconvert $piceps

        echo "done with on" $i
    done 
    rm ./pics/$continet/*ps

done