#!/bin/bash

# setting the frame of the graph to be of plain style (no black and white bar)
gmt gmtset PS_MEDIA = a1
gmt gmtset MAP_FRAME_TYPE = plain

######### REGION & SCALE #########  
cht=-JX15c/5c
# region depends on the values that i will generate



######### TIF FILES #########
#  for species richness
sr=./tif-code-file/birds_no_seabirds_sr_wgs84.grd #birds

# original resolution for environmental variables
prec_30arcs=./tif-code-file/12_geographic.grd
topo_1arcmin=./tif-code-file/ETOPO1_Ice_g_gmt4.grd
temp_30arcs=./tif-code-file/1_geographic.grd
temprange_30arcs=./tif-code-file/7_geographic.grd


# define the continent
continet=africa
mkdir ./pics/$continet/

######### GAUSSIAN FILTERING LOOP ######### 
# filteringvalue=10
for filteringvalue in 200; do 
    echo 'starting with gaussian filtering value' $filteringvalue 'Km'

    ######### VALUES EXTRACTION FROM TRANSECTS #########
    for i in 0; do 
        echo "working on parallel of latitude" $i "in the continent" $continet 
        
        #outfile
        picps=./pics/$continet/paper-figure_${i}_${filteringvalue}km.ps
        piceps=./pics/$continet/paper-figure_${i}_${filteringvalue}km.eps


        # Define latitude range (e.g., between -60 and 60 for the Americas)
        lat0=$i
        lat1=$i

        # Define start and end longitude
        lon0=-19  
        lon1=52   

        # Placing tose coordinates in a file
        touch transect.ll
        echo $lon0 $lat0 > transect.ll
        echo $lon1 $lat1 >> transect.ll

        # generating the transect every 10 Km
        gmt sample1d transect.ll -I10k -Apl | gmt mapproject -Gk > transect_temp.ll # instead this one uses Rhumb lines

        # FILTER OUT OCEANS POINTS
        # Track points against the land mask
        gmt grdtrack transect_temp.ll -G./tif-code-file/land_mask_forETOPO.grd > transect_with_mask.ll
        # Filter out points in the ocean (where landmask value is 0)
        awk '$4 == 1 {print $1, $2, $3}' transect_with_mask.ll > transect_filtered.ll

        # RECALCULATE the distance 
        # Get the first distance value from the data (3rd column of the 2nd line onward)
        first_distance=$(awk 'NR==1 {print $3}' transect_filtered.ll)
        # Process each line, adjusting the distance column to start from zero
        awk -v first_dist="$first_distance" '{$3 = $3 - first_dist; print }' transect_filtered.ll > transect_filtered_updated_distance.ll

        # getting the number species of the transect and precipitations
        echo "Longitude Latitude Distance SpeciesRichness Precipitation Topography Temperature TempRange" > transect.lldspetr
        gmt grdtrack transect_filtered_updated_distance.ll -G$sr -G$prec_30arcs -G$topo_1arcmin -G$temp_30arcs -G$temprange_30arcs >> transect.lldspetr

        # applying the gaussian smoothing to all env variables
        awk 'NR > 1 {print $3, $4}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > sr_gauss.txt
        awk 'NR > 1 {print $3, $5}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > prec_gauss.txt
        awk 'NR > 1 {print $3, $6}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > topo_gauss.txt
        awk 'NR > 1 {print $3, $7}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > temp_gauss.txt
        awk 'NR > 1 {print $3, $8}' transect.lldspetr | gmt filter1d -Fg$filteringvalue -E > temprange_gauss.txt

        # Combine all files into a new file, including the original first two columns (longitude and latitude)
        echo "Distance SpeciesRichness Precipitation Topography Temperature TempRange" > transect_gauss.lldspetr
        paste <(awk '{print $1, $2}' sr_gauss.txt) \
            <(awk '{print $2}' prec_gauss.txt ) \
            <(awk '{print $2}' topo_gauss.txt) \
            <(awk '{print $2}' temp_gauss.txt) \
            <(awk '{print $2}' temprange_gauss.txt) \
            >> transect_gauss.lldspetr

        # run the python script to calculate absoulte derivatives
        python3 derivative.py
        # the script above will also calculate the correlation coefficient between the species richness and the environmental variables
        
        # gaussian smoothing of the derivatives, derivative of the original function is stored in derivtaive_ens.dd
        awk 'NR > 1 {print $1, $2}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > prec_der_gauss.txt
        awk 'NR > 1 {print $1, $3}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > topo_der_gauss.txt
        awk 'NR > 1 {print $1, $4}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > temp_der_gauss.txt
        awk 'NR > 1 {print $1, $5}' derivatives_env.dd | gmt filter1d -Fg$filteringvalue -E > range_der_gauss.txt

        # Combine all files into a new file whihc will contain gaussian smoothed derivatives
        echo "Distance  Precipitation Topography Temperature TempRange" > derivatives_env_gauss.lldspetr
        paste <(awk '{print $1, $2}' prec_der_gauss.txt ) \
            <(awk '{print $2}' topo_der_gauss.txt) \
            <(awk '{print $2}' temp_der_gauss.txt) \
            <(awk '{print $2}' range_der_gauss.txt) \
            >> derivatives_env_gauss.lldspetr
        
        # create a chart of correlations 
        /Library/Frameworks/Python.framework/Versions/3.11/bin/python3 correlation-charts.py
        mv correlation.jpg ./pics/$continet/correlation_${i}_${filteringvalue}.jpg
        # Clean up intermediate files
        rm prec_gauss.txt topo_gauss.txt temp_gauss.txt temprange_gauss.txt sr_gauss.txt prec_der_gauss.txt topo_der_gauss.txt temp_der_gauss.txt range_der_gauss.txt





    ########### PLOTTING STARTS ###########

        # plot species as a function of distance, first we calculate the range
        mind=$(awk 'NR > 1 {if(min=="") {min=$3}; if($3 < min) min=$3} END {print min-10}' transect.lldspetr) 
        maxd=$(awk 'NR > 1 {if($3 > max) max=$3} END {print max+10}' transect.lldspetr)
        maxsr=$(awk 'NR > 1 {if($4 > max) max=$4} END {print max+10}' transect.lldspetr)

        # calculating the maximum vale of the derivate (smoothed) so to set limits on plots (this is an alternative way to extract values with awk, vs the one above)
        maxprder=$(awk 'NR > 1 {if($2 > max) max=$2} END {print max+10}' derivatives_env_gauss.lldspetr)
        maxtopoder=$(awk 'NR > 1 {if($3 > max) max=$3} END {print max+10}' derivatives_env_gauss.lldspetr)
        maxtempder=$(awk 'NR > 1 {if($4 > max) max=$4} END {print max+0}' derivatives_env_gauss.lldspetr)
        maxrangeder=$(awk 'NR > 1 {if($5 > max) max=$5} END {print max+0}' derivatives_env_gauss.lldspetr)

        # defining the  -R flag limits
        limpr_der=-R$mind/$maxd/0/$maxprder
        limtopo_der=-R$mind/$maxd/0/$maxtopoder
        limtemp_der=-R$mind/$maxd/0/$maxtempder
        limrange_der=-R$mind/$maxd/0/$maxrangeder


        # calculating the maximum value of the precipitations (and so on) so to set limits on plots
        maxpr=$(awk 'NR > 1 {if($5 > max) max=$5} END {print max+100}' transect.lldspetr)
        maxtopo=$(awk 'NR > 1 {if($6 > max) max=$6} END {print max+100}' transect.lldspetr)
        maxtemp=$(awk 'NR > 1 {if($7 > max) max=$7} END {print max+10}' transect.lldspetr)
        maxrange=$(awk 'NR > 1 {if($8 > max) max=$8} END {print max+10}' transect.lldspetr)

        # defining the  -R flag limits
        limsr=-R$mind/$maxd/0/$maxsr
        limpr=-R$mind/$maxd/0/$maxpr
        limtopo=-R$mind/$maxd/0/$maxtopo
        limtemp=-R$mind/$maxd/0/$maxtemp
        limrange=-R$mind/$maxd/0/$maxrange

    ########## PRECIPITATION ##########

        # first plot
        gmt psbasemap $limsr $cht -BWn -Bx1000f500 -By300f100+l"Species Richness" --FONT_LABEL=12p,seagreen --FONT_ANNOT_PRIMARY=12p,seagreen  -Y20c -K -P >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps

        # adding a secondary axis
        gmt psbasemap $limpr $cht -Bx1000f100 -By1000f500 --FONT_ANNOT_PRIMARY=12p,darkblue -BE -O -K >> $picps
        awk 'NR > 1 {print $1, $3}' < transect_gauss.lldspetr | gmt psxy $limpr $cht -Ba0 -W0.02i,darkblue -O -K >> $picps
        

        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "precipitation" {print $2}' correlation_results.txt)@["
        x_r=0.02
        x_y=0.72
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=darkblue >> $picps
        # plot text that says what plot is what
        x_text=0.02
        y_text=0.82
        echo $x_text $y_text "Precipitation, @[Pn@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=darkblue >> $picps

        # add title as ps text
        x_title=0.5
        y_title=1.2
        echo $x_title $y_title "Environmental Variables" | gmt pstext -R0/1/0/1 $cht -F+f18p+jCB -W0.02i -C0.3c -N -O -K >> $picps

    
    ########## DERIVATIVE OF PRECIPITATION ##########

        # first plot
        gmt psbasemap $limsr $cht -Bx1000f500 -By300f100a --FONT_LABEL=seagreen --FONT_ANNOT_PRIMARY=12p,seagreen -Bwn -O -X17c -K>> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps

        # adding a secondary axis
        gmt psbasemap $limpr_der $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p,cornflowerblue --FONT_LABEL=16p,cornflowerblue -BE -O -K>> $picps
        awk 'NR > 1 {print $1, $2}' < derivatives_env_gauss.lldspetr | gmt psxy $limpr_der $cht -Ba0 -W0.02i,cornflowerblue -O -K >> $picps
        

        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "derivative_precipitation" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=cornflowerblue >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Precipitation, @[|{\rm d}Pn/{\rm d}x|@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=cornflowerblue >> $picps


        # add title as ps text
        echo $x_title $y_title "Absolute Derivative of Environmental Variables" | gmt pstext -R0/1/0/1 $cht -F+f18p+jCB  -W0.02i -C0.3c -N -O -K >> $picps
    

    ########## ELEVATION ##########
        # second plot on right
        gmt psbasemap $limsr $cht -Bx1000f100 -By300f100a+l"Species Richness" --FONT_LABEL=12p,seagreen --FONT_ANNOT_PRIMARY=12p,seagreen -BW -O -Y-5.5c -X-17c -K >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps

        # adding species richness on a secondary axis
        gmt psbasemap $limtopo $cht -Bx1000f100 -By1000f500 --FONT_ANNOT_PRIMARY=12p,darkbrown  -BE -O -K >> $picps
        # awk 'NR > 1 {print $3, $5}' < transect.lldspetr | gmt psxy $limpr $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $4}' < transect_gauss.lldspetr | gmt psxy $limtopo $cht -Ba0 -W0.02i,darkbrown -O -K >> $picps


        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "topography" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=darkbrown >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Elevation, @[E@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=darkbrown >> $picps


    ########## DERIVATIVE ELEVATION ##########

        # first plot
        gmt psbasemap $limsr $cht -Bx1000f100 -By300f100a --FONT_LABEL=seagreen --FONT_ANNOT_PRIMARY=12p -Bw -K -O -X17c >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps
        
        # adding a secondary axis
        gmt psbasemap $limtopo_der $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p,peru --FONT_LABEL=16p,peru -BE -O -K>> $picps
        awk 'NR > 1 {print $1, $3}' < derivatives_env_gauss.lldspetr | gmt psxy $limtopo_der $cht -Ba0 -W0.02i,peru -O -K >> $picps
        

        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "derivative_topography" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=peru >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Elevation, @[|{\rm d}E/{\rm d}x|@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=peru >> $picps


    ########## MEAN ANNUAL TEMPERATURE ##########
        
        # second plot on right
        gmt psbasemap $limsr $cht -Bx1000f100 -By300f100a+l"Species Richness" --FONT_LABEL=12p,seagreen --FONT_ANNOT_PRIMARY=12p,seagreen -BW -O -X-17c -Y-5.5c -K >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps
        
        # adding a secondary axis
        gmt psbasemap $limtemp $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p,darkmagenta -BE -O -K>> $picps
        awk 'NR > 1 {print $1, $5}' < transect_gauss.lldspetr | gmt psxy $limtemp $cht -Ba0 -W0.02i,darkmagenta -O -K >> $picps         


        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "temperature" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=darkmagenta >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Temperature, @[T@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=darkmagenta >> $picps

    
    
    
    ########## DERIVATIVE MEAN ANNUAL TEMPERATURE ##########
        # first plot
        gmt psbasemap $limsr $cht -Bx1000f100 -By300f100a --FONT_LABEL=12p,seagreen --FONT_ANNOT_PRIMARY=12p -Bw -K -O -X17c >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps

        # adding species richness on a secondary axis
        gmt psbasemap $limtemp_der $cht -Bx1000f100 -By0.10f0.05 --FONT_ANNOT_PRIMARY=12p,mediumorchid --FONT_LABEL=16p,mediumorchid -BE -O -K>> $picps
        
        # awk 'NR > 1 {print $1, $4}' < derivatives_env.dd | gmt psxy $limtemp_der $cht -Ba0 -W0.02i,gray -O -K >> $picps
        awk 'NR > 1 {print $1, $4}' < derivatives_env_gauss.lldspetr | gmt psxy $limtemp_der $cht -Ba0 -W0.02i,mediumorchid -O -K >> $picps


        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "derivative_temperature" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=mediumorchid >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Temperature, @[|{\rm d}T/{\rm d}x|@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=mediumorchid >> $picps





    ########## TEMPERATURE RANGE ##########
        
        # second plot on right
        gmt psbasemap $limsr $cht -Bx1000f500 -By300f100a+l"Species Richness" --FONT_LABEL=12p,seagreen --FONT_ANNOT_PRIMARY=12p,seagreen -BW -O -Y-5.5c -X-17c -K >> $picps
        gmt psbasemap $limsr $cht -Bx1000f500+l"Distance, km" -By100f50 --FONT_LABEL=12p --FONT_ANNOT_PRIMARY=12p -BS -O -K >> $picps # adding another baseplot so that I can make the x label of a different colour
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps
        
        # adding a secondary axis
        gmt psbasemap $limrange $cht -Bx1000f100 -By10f5 --FONT_ANNOT_PRIMARY=12p,orangered3 -BE -O -K>> $picps
        awk 'NR > 1 {print $1, $6}' < transect_gauss.lldspetr | gmt psxy $limrange $cht -Ba0 -W0.02i,orangered3 -O -K >> $picps

        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "temperature_range" {print $2}' correlation_results.txt)@["
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=orangered3 >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Temperature Range, @[\Delta T@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O -K --FONT=orangered3 >> $picps

        

    ########## DERIVATIVE TEMPERATURE RANGE ##########

        # first plot
        gmt psbasemap $limsr $cht -Bx1000f500+l"Distance, km" -By300f100a --FONT_LABEL=12p --FONT_ANNOT_PRIMARY=12p -BwS -K -O -X17c >> $picps
        awk 'NR > 1 {print $1, $2}' < transect_gauss.lldspetr | gmt psxy $limsr $cht -Ba0 -W0.02i,seagreen -O -K >> $picps
        
        # adding species richness on a secondary axis
        
        gmt psbasemap $limrange_der $cht -Bx1000f500 -By0.05f0.01 --FONT_ANNOT_PRIMARY=12p,tomato1 --FONT_LABEL=16p,tomato1 -BE -O -K >> $picps
        awk 'NR > 1 {print $1, $5}' < derivatives_env_gauss.lldspetr | gmt psxy $limrange_der $cht -Ba0 -W0.02i,tomato1 -O -K >> $picps
        

        # plot the r, correlation coeffient
        r="@[r=$(awk '$1 == "derivative_temperature_range" {print $2}' correlation_results.txt)@[*"
        echo $x_r $x_y $r | gmt pstext -R0/1/0/1 $cht -F+f17p+jLB -N -O -K --FONT=tomato1 >> $picps
        # plot text that says what plot is what
        echo $x_text $y_text "Temperature Range, @[|{\rm d} \Delta T/{\rm d}x|@[" | gmt pstext -R0/1/0/1 $cht -F+f16p+jLB -N -O --FONT=tomato1 >> $picps


    # finishing up
        # Convert to JPEG
        ps2eps -f $picps
        gmt psconvert $piceps -E600 -Tg -A -P

        echo "done with on" $i
    done 
    rm ./pics/$continet/*ps

done
mkdir ./pics/$continet/birds/paper-figure
mv ./pics/$continet/*png ./pics/$continet/birds/paper-figure